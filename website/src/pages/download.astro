---
import "../styles/landing.css";
import "../styles/download.css";
import release from "../release.json";

const base = `${import.meta.env.BASE_URL.replace(/\/$/, "")}/`;
const github = "https://github.com/0xmiki/figmaboy";
const docs = `${base}docs/`;
const version = release.version;
const releaseTag = `v${version}`;
const releaseBase = `${github}/releases/download/${releaseTag}`;
const asset = (name: string) => `${releaseBase}/${name}`;

const assets = {
  macArmDmg: asset(`Figmaboy_${version}_darwin_aarch64.dmg`),
  macIntelDmg: asset(`Figmaboy_${version}_darwin_x64.dmg`),
  windowsNsis: asset(`Figmaboy_${version}_windows_x64.exe`),
  windowsMsi: asset(`Figmaboy_${version}_windows_x64.msi`),
  linuxAppImage: asset(`Figmaboy_${version}_linux_amd64.AppImage`),
  linuxDeb: asset(`Figmaboy_${version}_linux_amd64.deb`),
  linuxRpm: asset(`Figmaboy_${version}_linux_x86_64.rpm`),
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="theme-color" content="#ffffff" />
    <meta name="description" content="Download Figmaboy for macOS, Windows, or Linux." />
    <meta property="og:title" content="Download Figmaboy" />
    <meta property="og:description" content="Choose the Figmaboy desktop installer for your platform and start designing with Codex." />
    <meta property="og:type" content="website" />
    <link rel="icon" href={`${base}favicon.png`} />
    <link rel="canonical" href="https://0xmiki.github.io/figmaboy/download/" />
    <title>Download Figmaboy</title>
  </head>
  <body class="download-page">
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-nav">
      <div class="wrap nav-inner">
        <a class="brand" href={base} aria-label="Figmaboy home"><img src={`${base}figmaboy-dark.svg`} alt="" /></a>
        <nav class="nav-links" aria-label="Primary navigation">
          <a href={docs}>Docs</a>
          <a href={github}>GitHub</a>
          <span class="download-version"><span data-version>{releaseTag}</span>&nbsp; latest</span>
        </nav>
      </div>
    </header>

    <main id="main">
      <section class="download-hero" aria-labelledby="download-title">
        <div class="wrap download-hero-grid">
          <div class="download-intro">
            <h1 class="display" id="download-title">Download Figmaboy.</h1>
            <p>Get the desktop app for macOS, Windows, or Linux. Your designs stay on your machine, and the built-in Codex tab is ready when you open a file.</p>
            <div class="platform-index" aria-label="Supported platforms"><span>macOS</span><span>Windows</span><span>Linux</span></div>
          </div>

          <article class="detected-download" aria-live="polite">
            <div class="detected-top"><span>Recommended</span><span data-detected-label>Detecting...</span></div>
            <div class="detected-body">
              <h2 data-detected-title>Choose your platform</h2>
              <p data-detected-copy>Choose macOS, Windows, or Linux below.</p>

              <div class="detected-actions" data-actions="unknown">
                <a class="download-button primary" href="#all-downloads">View all downloads <span>↓</span></a>
              </div>
              <div class="detected-actions" data-actions="macos" hidden>
                <a class="download-button primary" data-asset="mac-arm-dmg" href={assets.macArmDmg}>Apple Silicon <span>↓</span></a>
                <a class="download-button secondary" data-asset="mac-intel-dmg" href={assets.macIntelDmg}>Intel Mac <span>↓</span></a>
              </div>
              <div class="detected-actions" data-actions="windows" hidden>
                <a class="download-button primary" data-asset="windows-nsis" href={assets.windowsNsis}>Download .exe <span>↓</span></a>
                <a class="download-button secondary" data-asset="windows-msi" href={assets.windowsMsi}>Get MSI <span>↓</span></a>
              </div>
              <div class="detected-actions" data-actions="linux" hidden>
                <a class="download-button primary" data-asset="linux-appimage" href={assets.linuxAppImage}>Get AppImage <span>↓</span></a>
                <a class="download-button secondary" href="#linux">.deb / .rpm <span>↓</span></a>
              </div>
            </div>
            <div class="detected-foot"><span>Open source</span><span>Codex built in</span><span>Local files</span></div>
          </article>
        </div>
      </section>

      <section class="release-band" aria-label="Latest release information">
        <div class="wrap release-band-grid">
          <div><span>Release</span><strong data-version>{releaseTag}</strong></div>
          <div><span>Status</span><strong>Latest</strong></div>
          <div><span>Platforms</span><strong>macOS, Windows, Linux</strong></div>
          <div><span>License</span><strong>MIT</strong></div>
        </div>
      </section>

      <section class="all-downloads" id="all-downloads" aria-labelledby="all-downloads-title">
        <div class="wrap">
          <header class="download-section-head">
            <div><span class="section-label">All platforms</span><h2 class="display" id="all-downloads-title">Choose your build.</h2></div>
            <p>Every <span data-version>{releaseTag}</span> installer includes the design tools used by the built-in Codex tab.</p>
          </header>

          <div class="platform-grid">
            <article class="platform-card" id="macos" data-platform-card="macos">
              <header><div><p>Apple</p><h3>macOS</h3></div><span class="platform-status">DMG</span></header>
              <div class="asset-list">
                <a data-asset="mac-arm-dmg" href={assets.macArmDmg}><span><b>Apple Silicon</b><small>For M-series Macs</small></span><i>↓</i></a>
                <a data-asset="mac-intel-dmg" href={assets.macIntelDmg}><span><b>Intel Mac</b><small>For Intel-based Macs</small></span><i>↓</i></a>
              </div>
            </article>

            <article class="platform-card" id="windows" data-platform-card="windows">
              <header><div><p>Microsoft</p><h3>Windows</h3></div><span class="platform-status">x64</span></header>
              <div class="asset-list">
                <a data-asset="windows-nsis" href={assets.windowsNsis}><span><b>Windows installer</b><small>Recommended for most people</small></span><i>↓</i></a>
                <a data-asset="windows-msi" href={assets.windowsMsi}><span><b>Windows MSI</b><small>For managed installations</small></span><i>↓</i></a>
              </div>
            </article>

            <article class="platform-card" id="linux" data-platform-card="linux">
              <header><div><p>Linux</p><h3>Linux</h3></div><span class="platform-status">x64</span></header>
              <div class="asset-list">
                <a data-asset="linux-appimage" href={assets.linuxAppImage}><span><b>AppImage</b><small>Portable, no installation required</small></span><i>↓</i></a>
                <a data-asset="linux-deb" href={assets.linuxDeb}><span><b>Debian / Ubuntu</b><small>Debian package</small></span><i>↓</i></a>
                <a data-asset="linux-rpm" href={assets.linuxRpm}><span><b>Fedora / RHEL</b><small>RPM package</small></span><i>↓</i></a>
              </div>
            </article>
          </div>

          <div class="release-links"><a href={`${github}/releases/latest`}>Release notes ↗</a><a href={`${github}/releases/latest/download/SHA256SUMS`}>SHA256SUMS ↓</a></div>
        </div>
      </section>

      <section class="connect-next" aria-labelledby="connect-title">
        <div class="wrap connect-next-grid">
          <div><span class="section-label">After installation</span><h2 class="display" id="connect-title">Open it and start designing.</h2></div>
          <div class="connect-copy"><p>Create a design and open the Codex tab. Figmaboy connects its built-in design tools automatically.</p><a class="download-button primary" href={`${docs}getting-started/quickstart/`}>Create your first design <span>→</span></a></div>
        </div>
      </section>
    </main>

    <footer class="download-footer">
      <div class="wrap footer-row"><span>Figmaboy <span data-version>{releaseTag}</span></span><span class="footer-links"><a href={docs}>Docs</a><a href={github}>GitHub</a><a href={`${github}/issues`}>Issues</a></span><span>MIT licensed</span></div>
    </footer>

    <script>
      type Platform = "macos" | "windows" | "linux" | "unknown";

      const browserNavigator = navigator as Navigator & { userAgentData?: { platform?: string } };
      const userAgent = browserNavigator.userAgent.toLowerCase();
      const platformHint = `${browserNavigator.userAgentData?.platform ?? ""} ${browserNavigator.platform ?? ""} ${userAgent}`.toLowerCase();
      const platform: Platform = /android|iphone|ipad/.test(userAgent)
        ? "unknown"
        : /mac/.test(platformHint)
          ? "macos"
          : /win/.test(platformHint)
            ? "windows"
            : /linux|x11/.test(platformHint)
              ? "linux"
              : "unknown";

      const recommendations = {
        macos: { label: "macOS detected", title: "Download for macOS", copy: "Choose Apple Silicon for M-series Macs, or Intel for older Macs." },
        windows: { label: "Windows detected", title: "Download for Windows", copy: "The .exe installer works for most people. MSI is available for managed installations." },
        linux: { label: "Linux detected", title: "Download for Linux", copy: "Use the AppImage, or choose a .deb or .rpm package below." },
        unknown: { label: "Choose a platform", title: "Choose your platform", copy: "Select macOS, Windows, or Linux below." },
      } as const;

      const recommendation = recommendations[platform];
      document.documentElement.dataset.platform = platform;
      document.querySelector<HTMLElement>("[data-detected-label]")!.textContent = recommendation.label;
      document.querySelector<HTMLElement>("[data-detected-title]")!.textContent = recommendation.title;
      document.querySelector<HTMLElement>("[data-detected-copy]")!.textContent = recommendation.copy;
      document.querySelectorAll<HTMLElement>("[data-actions]").forEach((element) => {
        element.hidden = element.dataset.actions !== platform;
      });
      document.querySelector(`[data-platform-card="${platform}"]`)?.classList.add("detected");

      const assetPatterns: Record<string, RegExp> = {
        "mac-arm-dmg": /_darwin_aarch64\.dmg$/,
        "mac-intel-dmg": /_darwin_x64\.dmg$/,
        "windows-nsis": /_windows_x64\.exe$/,
        "windows-msi": /_windows_x64\.msi$/,
        "linux-appimage": /_linux_amd64\.AppImage$/,
        "linux-deb": /_linux_amd64\.deb$/,
        "linux-rpm": /_linux_x86_64\.rpm$/,
      };

      async function hydrateLatestRelease() {
        try {
          const response = await fetch("https://api.github.com/repos/0xmiki/figmaboy/releases/latest", {
            headers: { Accept: "application/vnd.github+json" },
          });
          if (!response.ok) return;
          const release = await response.json() as { tag_name?: string; assets?: Array<{ name: string; browser_download_url: string }> };
          if (release.tag_name) {
            document.querySelectorAll<HTMLElement>("[data-version]").forEach((element) => {
              element.textContent = release.tag_name!;
            });
          }
          for (const element of document.querySelectorAll<HTMLAnchorElement>("[data-asset]")) {
            const pattern = assetPatterns[element.dataset.asset ?? ""];
            const matchedAsset = pattern ? release.assets?.find((candidate) => pattern.test(candidate.name)) : undefined;
            if (matchedAsset) element.href = matchedAsset.browser_download_url;
          }
        } catch {
          // Static links remain usable when GitHub's API is unavailable.
        }
      }

      void hydrateLatestRelease();
    </script>
  </body>
</html>
