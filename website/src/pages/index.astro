---
import "../styles/landing.css";
import phosphor from "@iconify-json/ph/icons.json";
import release from "../release.json";

const base = `${import.meta.env.BASE_URL.replace(/\/$/, "")}/`;
const github = "https://github.com/0xmiki/figmaboy";
const docs = `${base}docs/`;
const download = `${base}download/`;
const actualDesign = `${base}figmaboy-landing-page-asset.png`;
const actualDesignFileId = "file_2713dfb9-bc98-4788-90c1-43ce48726e9e";
const releaseTag = `v${release.version}`;
const phosphorIcons = phosphor.icons as Record<string, { body: string }>;
const ph = (name: string) => phosphorIcons[name]?.body ?? "";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="theme-color" content="#ffffff" />
    <meta name="description" content="Figmaboy is a local-first desktop interface design tool with Codex built beside the canvas." />
    <meta property="og:title" content="Figmaboy — design interfaces with Codex" />
    <meta property="og:description" content="Draw by hand or ask Codex to create and refine native, editable layers on the same canvas." />
    <meta property="og:type" content="website" />
    <meta property="og:image" content="https://raw.githubusercontent.com/0xmiki/figmaboy/main/docs/assets/figmaboy-codex-workflow.png" />
    <link rel="icon" href={`${base}favicon.png`} />
    <link rel="canonical" href="https://0xmiki.github.io/figmaboy/" />
    <title>Figmaboy — design interfaces with Codex</title>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>

    <header class="site-header">
      <nav class="nav shell" aria-label="Primary navigation">
        <a class="wordmark" href={base} aria-label="Figmaboy home">
          <img src={`${base}figmaboy-blue.svg`} alt="" width="28" height="28" />
        </a>
        <div class="nav-links">
          <a href={docs}>Docs</a>
          <a href={github}>GitHub</a>
          <a class="nav-cta" href={download}><span data-download-copy>Download</span></a>
        </div>
      </nav>
    </header>

    <main id="main">
      <section class="hero shell" aria-labelledby="hero-title">
        <h1 id="hero-title">Design interfaces with Codex.</h1>
        <p>Figmaboy puts the Codex CLI beside a native design canvas. Signed in with the ChatGPT account you already use. No API key or MCP setup.</p>
        <div class="hero-actions">
          <a class="button primary" href={download}><span data-download-copy>Download Figmaboy</span></a>
        </div>
        <span class="availability">{releaseTag} · Linux, macOS, and Windows</span>
      </section>

      <figure class="product shell-wide" aria-labelledby="product-caption" data-design-file={actualDesignFileId}>
        <div class="product-app">
          <aside class="app-left" aria-label="Pages and layers">
            <div class="app-rail">
              <div class="app-rail-item active"><svg viewBox="0 0 256 256" set:html={ph("file")}></svg><span>File</span></div>
              <div class="app-rail-item"><svg viewBox="0 0 256 256" set:html={ph("shapes")}></svg><span>Assets</span></div>
              <div class="app-rail-item"><svg viewBox="0 0 256 256" set:html={ph("toolbox")}></svg><span>Tools</span></div>
            </div>
            <div class="app-browser">
              <header><b>Radio concept</b><svg viewBox="0 0 256 256" set:html={ph("dots-three")}></svg></header>
              <section><b>Pages</b><span class="browser-actions"><svg viewBox="0 0 256 256" set:html={ph("magnifying-glass")}></svg><svg viewBox="0 0 256 256" set:html={ph("plus")}></svg></span></section>
              <div class="page-row">Radio</div>
              <section><b>Layers</b><span class="sliders">⌁</span></section>
              <div class="layer-tree">
                <b><i>⌄</i><svg viewBox="0 0 256 256" set:html={ph("frame-corners")}></svg>Sonic 60 — Radio Player</b>
                <span><i>⌄</i><svg viewBox="0 0 256 256" set:html={ph("frame-corners")}></svg>System status bar</span>
                <span><i>⌄</i><svg viewBox="0 0 256 256" set:html={ph("frame-corners")}></svg>Header</span>
                <span><i>⌄</i><svg viewBox="0 0 256 256" set:html={ph("frame-corners")}></svg>Tuning console</span>
                <span class="nested"><svg viewBox="0 0 256 256" set:html={ph("text-t")}></svg>Frequency display</span>
                <span class="nested"><svg viewBox="0 0 256 256" set:html={ph("frame-corners")}></svg>Station info</span>
                <span><i>⌄</i><svg viewBox="0 0 256 256" set:html={ph("frame-corners")}></svg>Preset stations</span>
                <span><i>⌄</i><svg viewBox="0 0 256 256" set:html={ph("frame-corners")}></svg>Playback controls</span>
                <span><i>⌄</i><svg viewBox="0 0 256 256" set:html={ph("frame-corners")}></svg>Bottom navigation</span>
              </div>
            </div>
          </aside>
          <section class="app-canvas" aria-label="Design canvas">
            <header><b><svg viewBox="0 0 256 256" set:html={ph("caret-left")}></svg>Back</b><strong>Radio concept<svg viewBox="0 0 256 256" set:html={ph("caret-down")}></svg></strong><button aria-label="Copy design ID"><svg viewBox="0 0 256 256" set:html={ph("copy")}></svg></button><span>Saved locally</span></header>
            <div class="canvas-design"><img src={actualDesign} alt="Sonic 60 mobile radio interface created as native Figmaboy layers" width="946" height="2048" fetchpriority="high" /></div>
            <div class="app-toolbar" aria-hidden="true">
              <b><svg viewBox="0 0 256 256" set:html={ph("cursor")}></svg></b>
              <span><svg viewBox="0 0 256 256" set:html={ph("hand")}></svg></span>
              <i></i>
              <span><svg viewBox="0 0 256 256" set:html={ph("frame-corners")}></svg></span>
              <span><svg viewBox="0 0 256 256" set:html={ph("rectangle")}></svg></span>
              <span><svg viewBox="0 0 256 256" set:html={ph("text-t")}></svg></span>
              <i></i>
              <span><svg viewBox="0 0 256 256" set:html={ph("magnifying-glass-minus")}></svg></span>
              <small>78%</small>
              <span><svg viewBox="0 0 256 256" set:html={ph("magnifying-glass-plus")}></svg></span>
            </div>
          </section>
          <aside class="app-chat" aria-label="Codex sidebar">
            <div class="app-chat-tabs"><b>Codex</b><span>Design</span><span>Prototype</span><svg viewBox="0 0 256 256" set:html={ph("x")}></svg></div>
            <div class="app-chat-tools" aria-hidden="true">
              <svg viewBox="0 0 256 256" set:html={ph("dots-three")}></svg>
              <svg viewBox="0 0 256 256" set:html={ph("arrow-counter-clockwise")}></svg>
              <svg viewBox="0 0 256 256" set:html={ph("plus")}></svg>
            </div>
            <div class="chat-body">
              <div class="chat-prompt">Build a tactile mobile radio player with clear tuning controls and five station presets.</div>
              <p>I’ll inspect the open frame, build the radio interface as native layers, and review the finished design.</p>
              <div class="chat-work"><span>Worked for 1m 9s</span><svg viewBox="0 0 256 256" set:html={ph("caret-down")}></svg></div>
              <div class="chat-answer">
                <p>Built and reviewed the radio player.</p>
                <ul><li>Large tuning card with live frequency readout</li><li>Five presets with a clear active state</li><li>Playback, volume, and sleep controls</li><li>Every element remains a native editable layer</li></ul>
              </div>
            </div>
            <div class="chat-composer">
              <div class="chat-placeholder">Ask anything about this design</div>
              <div class="chat-composer-controls">
                <span><svg viewBox="0 0 256 256" set:html={ph("plus")}></svg></span>
                <span><svg viewBox="0 0 256 256" set:html={ph("clock")}></svg></span>
                <i></i>
                <em>GPT-5.6-Sol<svg viewBox="0 0 256 256" set:html={ph("caret-down")}></svg></em>
                <em><svg viewBox="0 0 256 256" set:html={ph("lightning")}></svg>Medium · Fast<svg viewBox="0 0 256 256" set:html={ph("caret-down")}></svg></em>
                <b><svg viewBox="0 0 256 256" set:html={ph("arrow-up")}></svg></b>
              </div>
            </div>
            <div class="chat-footer"><span>Working locally</span><span>Markdown · Shift ↵ newline</span></div>
          </aside>
        </div>
        <figcaption id="product-caption">The real Figmaboy editor with Sonic 60, a design made from 183 editable layers.</figcaption>
      </figure>

      <section class="work section shell" aria-labelledby="work-title">
        <div class="section-copy">
          <h2 id="work-title">Design the same file together.</h2>
          <p>Codex reads the open design and changes the native layers you edit by hand. Every result stays selectable, movable, and ready for another pass.</p>
        </div>
        <ol class="work-steps">
          <li><span>1</span><div><h3>Open a frame.</h3><p>Select the screen or component you want to change.</p></div></li>
          <li><span>2</span><div><h3>Describe the outcome.</h3><p>Codex inspects the current layers, makes the change, and reviews the rendered frame.</p></div></li>
          <li><span>3</span><div><h3>Keep designing.</h3><p>Edit the result yourself or continue the conversation without flattening your work.</p></div></li>
        </ol>
      </section>

      <section class="codex-account" aria-labelledby="account-title">
        <div class="shell account-grid">
          <div class="section-copy">
            <span class="section-label">Your Codex account</span>
            <h2 id="account-title">Use the Codex access you already have.</h2>
            <p>Figmaboy runs your installed Codex CLI and uses its existing ChatGPT login. Your normal Codex limits apply. Figmaboy does not resell tokens or require a separate API key.</p>
          </div>
          <div class="account-flow" aria-label="Figmaboy uses the existing Codex CLI login">
            <div><span>Codex CLI</span><b>Signed in</b></div>
            <span aria-hidden="true">→</span>
            <div><span>Figmaboy</span><b>Ready to design</b></div>
          </div>
        </div>
      </section>

      <section class="evolve" aria-label="Evolve">
        <div class="shell evolve-grid">
          <div class="section-copy">
            <span class="section-label">/evolve</span>
            <p>Select a frame and type <code>/evolve</code> with a direction. Figmaboy keeps the original untouched, creates an empty frame beside it, and invents a new composition one visible pass at a time.</p>
            <a class="text-link" href={`${docs}workflows/evolve/`}>How reconstruction works <span aria-hidden="true">→</span></a>
          </div>
          <div class="evolve-demo" aria-label="Figmaboy canvas with a reference, reconstruction, and the evolve command in Codex">
            <div class="demo-canvas">
              <div class="demo-frame reference-mini"><span>Reference</span><img src={actualDesign} alt="" /></div>
              <div class="demo-frame rebuild-mini"><span>Reconstruction</span><i></i><b></b><em></em></div>
            </div>
            <div class="demo-codex">
              <header><b>Codex</b><span>Design</span></header>
              <div class="demo-message"><code>/evolve</code> Rebuild this radio app with a simpler hierarchy.</div>
              <div class="demo-progress"><span></span><div><b>Reconstructing design</b><small>Pass 3 · Building playback controls</small></div></div>
              <div class="demo-composer">Ask anything about this design <i>↑</i></div>
            </div>
          </div>
        </div>
      </section>

      <section class="closing shell" aria-labelledby="closing-title">
        <h2 id="closing-title">Download Figmaboy.</h2>
        <p>Open source for Linux, macOS, and Windows.</p>
        <a class="button primary" href={download}><span data-download-copy>Download Figmaboy</span></a>
      </section>
    </main>

    <footer class="footer shell">
      <span>Figmaboy {releaseTag}</span>
      <nav aria-label="Footer navigation"><a href={docs}>Docs</a><a href={github}>GitHub</a><a href={`${github}/issues`}>Issues</a></nav>
      <span>MIT licensed</span>
    </footer>

    <script>
      const browserNavigator = navigator as Navigator & { userAgentData?: { platform?: string } };
      const userAgent = browserNavigator.userAgent.toLowerCase();
      const platformHint = `${browserNavigator.userAgentData?.platform ?? ""} ${browserNavigator.platform ?? ""} ${userAgent}`.toLowerCase();
      const platform = /android|iphone|ipad/.test(userAgent)
        ? null
        : /mac/.test(platformHint)
          ? "macOS"
          : /win/.test(platformHint)
            ? "Windows"
            : /linux|x11/.test(platformHint)
              ? "Linux"
              : null;

      if (platform) {
        document.querySelectorAll<HTMLElement>("[data-download-copy]").forEach((element) => {
          element.textContent = `Download for ${platform}`;
        });
      }
    </script>
  </body>
</html>
